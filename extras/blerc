# Emerald Case — optional ble.sh faces
# Adds syntax-aware color to commands you type without changing shell behavior.
# Intended to be sourced from ~/.blerc after ble.sh is available.

if declare -F ble-face >/dev/null 2>&1; then
  # Core command line
  ble-face -s syntax_default           fg=#c9d2cc
  ble-face -s syntax_command           fg=#49f397,bold
  ble-face -s command_file             fg=#49f397,bold
  ble-face -s command_builtin          fg=#72c8b0
  ble-face -s command_builtin_dot      fg=#72c8b0,bold
  ble-face -s command_alias            fg=#55a89b
  ble-face -s command_function         fg=#31d67b
  ble-face -s command_keyword          fg=#b79ac7,bold
  ble-face -s command_directory        fg=#5f8fa3,underline
  ble-face -s command_jobs             fg=#cf666b

  # Arguments / shell syntax
  ble-face -s argument_option          fg=#72c8b0
  ble-face -s argument_error           fg=#f3f7f4,bg=#cf666b
  ble-face -s syntax_quoted            fg=#d2ad5d
  ble-face -s syntax_quotation         fg=#e9c674,bold
  ble-face -s syntax_escape            fg=#b79ac7
  ble-face -s syntax_varname           fg=#7fb3c5
  ble-face -s syntax_param_expansion   fg=#55a89b
  ble-face -s syntax_function_name     fg=#31d67b,bold
  ble-face -s syntax_comment           fg=#5d6b62,italic
  ble-face -s syntax_glob              fg=#72c8b0,bold
  ble-face -s syntax_brace             fg=#b79ac7,bold
  ble-face -s syntax_tilde             fg=#5f8fa3,bold

  # Paths and completion
  ble-face -s filename_directory       fg=#5f8fa3,underline
  ble-face -s filename_link            fg=#55a89b,underline
  ble-face -s filename_executable      fg=#49f397,underline
  ble-face -s filename_warning         fg=#ed7f84,underline
  ble-face -s filename_url             fg=#72c8b0,underline
  ble-face -s auto_complete            fg=#5d6b62,italic
  ble-face -s menu_complete_match      fg=#49f397,bold
fi
